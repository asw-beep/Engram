# Copy to .env.prod next to docker-compose.prod.yml, fill it in, and keep it out of git
# (chmod 600 on a server). Start the stack with:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# A long random string of letters and digits only, because it goes into a database URL.
# Postgres has no public port, but the password still guards it.
POSTGRES_PASSWORD=

# From https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: raises GitHub's rate limit from 60 to 5,000 requests an hour.
GITHUB_TOKEN=
